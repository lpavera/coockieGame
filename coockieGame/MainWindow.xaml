<Window x:Class="coockieGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:coockieGame"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnCook" Content="susenka" HorizontalAlignment="Center" Margin="0,202,0,0" VerticalAlignment="Top" Height="39" Width="91" Click="Button_Click"/>
        <Button x:Name="btnShop" Content="Obchod" HorizontalAlignment="Left" Margin="710,10,0,0" VerticalAlignment="Top" Height="44" Width="80" Click="btnShop_Click"/>
        <TextBlock x:Name="txbCook" HorizontalAlignment="Center" Margin="0,83,0,0" TextWrapping="Wrap" Text="sušenky" VerticalAlignment="Top" Height="22" Width="100"/>
        <TextBlock x:Name="txbCklk" HorizontalAlignment="Center" Margin="0,110,0,0" TextWrapping="Wrap" Text="sušenka/klik" VerticalAlignment="Top" Height="22" Width="100"/>
        <TextBlock x:Name="txbCsec" HorizontalAlignment="Center" Margin="0,137,0,0" TextWrapping="Wrap" Text="sušenka/s" VerticalAlignment="Top" Height="22" Width="100"/>

    </Grid>
</Window>
